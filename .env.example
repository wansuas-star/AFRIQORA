# AFRIQORA Platform Environment Configuration Template
# Copy this file to .env before running

# Legacy Express Server
PORT=4000
ADMIN_KEY=REPLACE_WITH_SECURE_RANDOM_KEY
SESSION_SECRET=REPLACE_WITH_SECURE_SESSION_SECRET

# Canonical TypeScript Backend
BACKEND_PORT=4001
JWT_SECRET=REPLACE_WITH_SECURE_JWT_SECRET
VIEW_HMAC_SECRET=REPLACE_WITH_SECURE_HMAC_SECRET

# Database Connection (SQLite in Dev / PostgreSQL in Production)
DATABASE_URL="file:./prisma/dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/afriqora?schema=public"

# Monetization Configuration
EARNINGS_PER_VIEW=0.01
MAX_DAILY_VIEWS=5
PAYOUT_VIEWS_THRESHOLD=100

# Push Notifications (Optional / Placeholder)
FCM_SERVER_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.afriqora.app
