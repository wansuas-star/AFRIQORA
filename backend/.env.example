# AFRIQORA Backend Environment Configuration
# Copy this file to .env and fill in real values

PORT=4001
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
DATABASE_URL=file:./prisma/dev.db
VIEW_HMAC_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING
EARNINGS_PER_VIEW=0.01
MAX_DAILY_VIEWS=5
PAYOUT_VIEWS_THRESHOLD=100

# ==============================================================================
# Copernicus Data Space Ecosystem (CDSE) / Sentinel-1 & Sentinel-2 Configuration
# ==============================================================================
# Option 1 (Recommended): OAuth2 Client Credentials
# Register your OAuth client in CDSE User Portal (https://dataspace.copernicus.eu)
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Option 2: CDSE User Account Password Credentials (cdse-public client)
CDSE_USERNAME=
CDSE_PASSWORD=

# CDSE Service Endpoints (Defaults to official CDSE APIs)
CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
CDSE_CATALOGUE_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
CDSE_DOWNLOAD_URL=https://download.dataspace.copernicus.eu/odata/v1

# Future: PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/afriqora?schema=public
