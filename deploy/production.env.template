# ==============================================================================
# AFRIQORA Production Environment Configuration Template
# Destination: /var/www/afriqora/backend/.env
# Permissions: chmod 600 /var/www/afriqora/backend/.env
# ==============================================================================

NODE_ENV=production
PORT=4001

# Public Domain & CORS Security (Replace with your actual domain or VPS IP)
# Examples: https://afriqora.com or http://192.0.2.1
APP_URL=https://<YOUR_DOMAIN_OR_SERVER_IP>
CORS_ORIGIN=https://<YOUR_DOMAIN_OR_SERVER_IP>

# Cryptographic Master Secret
# Generate a secure 64-character hex secret using: openssl rand -hex 64
JWT_SECRET=<GENERATE_WITH_OPENSSL_RAND_HEX_64>

# Platform Authority Email (Platform Owner for administrative actions)
PLATFORM_OWNER_EMAIL=owner@<YOUR_DOMAIN>

# Database Connection (Persistent SQLite path relative to backend directory)
DATABASE_URL="file:./prisma/dev.db"

# AI Integration Flag (Strictly disabled as requested; reserved for future roadmap)
AI_EXPLANATION_ENABLED=false

# Copernicus Data Space Ecosystem (CDSE) Credentials (Optional for live satellite passes)
# Leave as placeholders or blank if using calibrated benchmark baselines initially
CDSE_CLIENT_ID=<OPTIONAL_COPERNICUS_CDSE_CLIENT_ID>
CDSE_CLIENT_SECRET=<OPTIONAL_COPERNICUS_CDSE_CLIENT_SECRET>

# Live External Connectors (Must remain false by default for security)
CCTV_INTEGRATION_ACTIVE=false
FORENSICS_INTEGRATION_ACTIVE=false
EXTERNAL_GOV_CONNECTORS_ACTIVE=false
