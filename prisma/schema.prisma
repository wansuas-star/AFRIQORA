generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String   @id @default(uuid())
  afriqoraId   String?  @unique
  email        String   @unique
  passwordHash String
  displayName  String
  username     String?  @unique
  bio          String?
  location     String?
  website      String?
  contact      String?
  profilePhoto String?
  createdAt    DateTime @default(now())
  
  // Settings
  twoFactor         Boolean @default(false)
  profileVisibility String  @default("public")
  sessionTimeout    String  @default("30m")
  
  sessions Session[]
  businesses BusinessProfile[]
  posts    Post[]

  // Relations
  followingUsers UserFollow[] @relation("FollowingUsers")
  followers      UserFollow[] @relation("UserFollowers")
  followingBusinesses BusinessFollow[]
  sentRequests     ConnectionRequest[] @relation("SentRequests")
  receivedRequests ConnectionRequest[] @relation("ReceivedRequests")
  likes            PostLike[]
  saves            PostSave[]
  shares           PostShare[]
  comments         Comment[]
  blocksMade       UserBlock[] @relation("Blocker")
  blocksReceived   UserBlock[] @relation("Blocked")
  serviceConnects  ServiceConnection[]

  sentEnquiries    BusinessEnquiry[] @relation("SentEnquiries")
  givenReviews     BusinessReview[] @relation("GivenReviews")
  wallet           Wallet?
  withdrawals      Withdrawal[] @relation("UserWithdrawals")
  reportsFiled     Report[] @relation("FiledReports")
}

model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("FollowingUsers", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model BusinessFollow {
  id         String   @id @default(uuid())
  followerId String
  businessId String
  createdAt  DateTime @default(now())

  follower User @relation(fields: [followerId], references: [id])
  business BusinessProfile @relation(fields: [businessId], references: [id])

  @@unique([followerId, businessId])
}

model ConnectionRequest {
  id          String   @id @default(uuid())
  requesterId String
  targetId    String
  status      String   @default("pending") // pending, accepted, declined
  message     String?
  createdAt   DateTime @default(now())

  requester User @relation("SentRequests", fields: [requesterId], references: [id])
  target    User @relation("ReceivedRequests", fields: [targetId], references: [id])

  @@unique([requesterId, targetId])
}

model Session {
  id        String   @id
  userId    String
  createdAt DateTime
  expiresAt DateTime
  
  user User @relation(fields: [userId], references: [id])
}

model BusinessProfile {
  id            String   @id @default(uuid())
  ownerId       String
  businessName  String
  location      String?
  country       String?
  category      String?
  description   String?
  phone         String?
  website       String?
  logo          String?
  hours         String? // Stored as JSON string
  categories    String? // Stored as JSON string
  services      String? // Stored as JSON string
  socialLinks   String? // Stored as JSON string
  serviceAreas  String? // Stored as JSON string
  languagesServed String? // Stored as JSON string
  faqs          String? // Stored as JSON string
  media         String? // Stored as JSON string
  semanticIndex String? 
  isMarketplace Boolean  @default(false)
  createdAt     DateTime @default(now())

  owner User @relation(fields: [ownerId], references: [id])
  posts Post[]
  followers BusinessFollow[]
  enquiries BusinessEnquiry[]
  reviews BusinessReview[]
}

model Post {
  id          String   @id @default(uuid())
  authorId    String
  businessId  String?
  title       String?
  text        String?
  video       String?
  type        String   @default("text")
  
  category    String?
  location    String?
  website     String?
  contact     String?
  image       String?
  topics      String? // JSON string
  publishedAt DateTime?
  authorLocationAllowed Boolean @default(false)
  authorLocation String?
  videoProcessing String? // JSON string
  status      String   @default("published")
  semanticIndex String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime?

  author   User             @relation(fields: [authorId], references: [id])
  business BusinessProfile? @relation(fields: [businessId], references: [id])
  likes    PostLike[]
  saves    PostSave[]
  shares   PostShare[]
  comments Comment[]
}

model Notification {
  id              String   @id @default(uuid())
  recipientUserId String
  actorUserId     String
  type            String
  title           String?
  message         String?
  route           String?
  metadata        String? // JSON string
  read            Boolean  @default(false)
  dedupeKey       String?  @unique
  createdAt       DateTime @default(now())
}

model Message {
  id              String   @id @default(uuid())
  senderId        String
  recipientId     String
  content         String?
  mediaUrl        String?
  status          String   @default("sent")
  createdAt       DateTime @default(now())
}

model PostLike {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model PostSave {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])

  @@unique([userId, postId])
}

model PostShare {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  platform  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  postId    String
  userId    String
  text      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}

model UserBlock {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id])
  blocked User @relation("Blocked", fields: [blockedId], references: [id])

  @@unique([blockerId, blockedId])
}

model ServiceConnection {
  id          String   @id @default(uuid())
  userId      String
  serviceName String
  permissions String?  // JSON string
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, serviceName])
}


// Stage 3F: Business & Analytics
model BusinessEnquiry {
  id          String   @id @default(uuid())
  businessId  String
  senderId    String
  message     String
  contactMode String   @default("in-app")
  status      String   @default("unread")
  createdAt   DateTime @default(now())

  business    BusinessProfile @relation(fields: [businessId], references: [id])
  sender      User            @relation("SentEnquiries", fields: [senderId], references: [id])
}

model BusinessReview {
  id          String   @id @default(uuid())
  businessId  String
  reviewerId  String
  rating      Int
  text        String?
  createdAt   DateTime @default(now())

  business    BusinessProfile @relation(fields: [businessId], references: [id])
  reviewer    User            @relation("GivenReviews", fields: [reviewerId], references: [id])

  @@unique([businessId, reviewerId])
}

// Stage 3G: Smart Reach
model SmartReachContent {
  contentId     String   @id
  stage         String   @default("initial")
  impressions   Int      @default(0)
  viewCount     Int      @default(0)
  score         Float    @default(0.0)
  lastEvaluated DateTime @default(now())
  metadata      String?  // JSON string for raw metrics (watch time, skips, etc)
}

// Stage 3H: Monetization
model Wallet {
  id               String   @id @default(uuid())
  userId           String   @unique
  totalViews       Int      @default(0)
  earnings         Float    @default(0.0)
  availableBalance Float    @default(0.0)
  
  user             User     @relation(fields: [userId], references: [id])
}

model Withdrawal {
  id        String   @id @default(uuid())
  userId    String
  amount    Float
  method    String?
  status    String   @default("pending")
  createdAt DateTime @default(now())

  user      User     @relation("UserWithdrawals", fields: [userId], references: [id])
}

// Global Singletons (Settings, Platform Config)
model GlobalSettings {
  id            String @id @default("default")
  platformPct   Float  @default(30.0)
  creatorPct    Float  @default(70.0)
  viewValue     Float  @default(0.001)
  totalEarnings Float  @default(0.0)
  smartReachCfg String? // JSON string
}

model VideoViewNonce {
  id        String   @id @default(uuid())
  videoId   String
  nonce     String
  createdAt DateTime @default(now())

  @@unique([videoId, nonce])
}

// Stage 3I: Moderation
model Report {
  id          String   @id @default(uuid())
  reporterId  String
  entityId    String
  entityType  String
  reason      String
  details     String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  reporter    User     @relation("FiledReports", fields: [reporterId], references: [id])
}

